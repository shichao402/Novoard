{
  "name": "novoard-hub",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Novoard hub：联邦注册表 + 任务队列 + A2A 端点 + 隧道（契约 SSOT；agent 见 novoard-agent 仓）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "dev": "node --watch src/main.mjs",
    "admin": "node src/admin.mjs",
    "contract-gate": "node scripts/check-contract-copy.mjs",
    "build:web": "npm --prefix web run build",
    "lint:web": "npm --prefix web run lint",
    "typecheck:web": "npm --prefix web run typecheck",
    "test:web": "npm --prefix web run test",
    "test:e2e": "npm --prefix web run test:e2e",
    "test": "npm run contract-gate && node --test \"test/*.mjs\"",
    "test:all": "npm test && npm run build:web && npm run typecheck:web && npm run lint:web && npm run test:web && npm run test:e2e"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.7",
    "ajv": "^8.17.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.0"
  }
}
